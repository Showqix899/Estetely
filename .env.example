# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Your frontend address; used to build the link inside the password reset email
FRONTEND_URL=http://localhost:3000

# ---- PostgreSQL ----
DB_NAME=estately_db
DB_USER=estately_user
DB_PASSWORD=estately_pass
DB_HOST=db
DB_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
REDIS_URL_CACHING=redis://redis:6379/1

# ---- Email (SMTP) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Estately <your-email@gmail.com>
